{
  "name": "sonora",
  "productName": "Enora",
  "version": "1.8.2",
  "description": "Enora — musique, films, radio et YouTube sans publicité, en ligne et hors-ligne (Windows + iPhone)",
  "main": "electron/main.js",
  "author": "Geld237",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/gen-electron-preload.js && electron .",
    "build:win": "node scripts/gen-electron-preload.js && electron-packager . Enora --platform=win32 --arch=x64 --out=dist --overwrite --no-asar --app-copyright=Enora --ignore=^/ios --ignore=^/plugins --ignore=^/dist --ignore=^/scripts --ignore=^/docs --ignore=capacitor.config.json --ignore=^/resources --ignore=^/README",
    "ios:add": "npx cap add ios && npm run ios:sync",
    "ios:sync": "node scripts/setup-ios.js && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "build:exe": "node scripts/gen-electron-preload.js && electron-builder --win",
    "android:sync": "node scripts/setup-android.js && npx cap sync android",
    "check": "node scripts/check.js",
    "build:mac": "node scripts/gen-electron-preload.js && electron-builder --mac",
    "build:linux": "node scripts/gen-electron-preload.js && electron-builder --linux"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "capacitor-youtube-adblock": "file:plugins/youtube-adblock",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@electron/packager": "^20.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.sonora.app",
    "productName": "Enora",
    "copyright": "Enora",
    "directories": {
      "output": "dist-exe"
    },
    "files": [
      "electron/**",
      "www/**",
      "adblock/**",
      "package.json"
    ],
    "asar": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Enora",
      "artifactName": "Enora-Setup-${version}.exe",
      "language": "1036",
      "installerLanguages": [
        "fr_FR"
      ]
    },
    "portable": {
      "artifactName": "Enora-Portable-${version}.exe"
    },
    "icon": "resources/icon.png",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.music",
      "icon": "resources/icon.png",
      "artifactName": "Enora-Mac-${version}.${ext}",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Enora ${version}",
      "artifactName": "Enora-Mac-${version}.dmg"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo",
      "icon": "resources/icon.png",
      "maintainer": "Geld237",
      "synopsis": "Musique, films et radio sans publicité",
      "artifactName": "Enora-Linux-${version}.${ext}"
    },
    "deb": {
      "artifactName": "Enora-Linux-${version}.deb"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Geld237/sonora.git"
  },
  "homepage": "https://geld237.github.io/sonora/",
  "bugs": {
    "url": "https://github.com/Geld237/sonora/issues"
  }
}
